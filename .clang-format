# Origin: upstream/multi-gpu-sort-merge-join/.clang-format
# AJB: AlignConsecutive for debug struct dumps, include grouping adds CUDA+ajb
BasedOnStyle: Google
ColumnLimit: 120
DerivePointerAlignment: false
AlignConsecutiveAssignments: Consecutive
AlignConsecutiveMacros: Consecutive
IncludeCategories:
  - Regex:           '^<cuda'
    Priority:        0
  - Regex:           '^<cub/'
    Priority:        0
  - Regex:           '^<thrust/'
    Priority:        0
  - Regex:           '^<.*\.(h|hpp|hxx|cuh)>'
    Priority:        2
  - Regex:           '^<.*'
    Priority:        1
  - Regex:           '^"(ajb_|skew_|tier_)'
    Priority:        4
  - Regex:           '.*'
    Priority:        3
SortIncludes: CaseInsensitive
